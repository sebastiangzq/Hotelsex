# ---- Copie este archivo a .env y complete los valores ----
NODE_ENV=development
PORT=3000

# Conexión de la APLICACIÓN (rol hotelsec_app, NO superusuario)
DATABASE_URL=postgres://hotelsec_app:CAMBIE_ESTA_CLAVE@localhost:5432/hotelsec
APP_DB_PASSWORD=CAMBIE_ESTA_CLAVE

# Conexión del DUEÑO de la BD: solo la usa "npm run setup:db"
OWNER_DATABASE_URL=postgres://postgres:su_clave@localhost:5432/hotelsec

# Clave maestra (32 bytes en base64). Genérela con: npm run gen:key
# Si la pierde, los datos cifrados (huéspedes, secretos 2FA) NO se pueden recuperar.
MASTER_KEY=

# Opcionales
# COOKIE_SECURE=true          # obligatorio si sirve por HTTPS
# TRUST_PROXY=1               # si está detrás de nginx/Cloudflare
# APP_ORIGIN=https://hotel.ejemplo.bo
# SESSION_ABS_HOURS=8         # vida máxima de una sesión aunque haya actividad
# MAX_FALLOS_POR_IP=20        # fallos de login por IP en 15 min antes de bloquear la IP
# RATE_LOGIN_MAX=30           # peticiones a /login por IP en 15 min
